# Copie para .env (ignorado pelo git). Nenhum segredo real aqui.

# Onde ficam os bancos SQLite (um arquivo por serviço: data/<servico>.db)
DATA_DIR=data

# Onde os serviços descobrem as URLs uns dos outros
SERVICES_FILE=services.json

# Logs
LOG_LEVEL=INFO

# JWT (emitido pela Identidade, validado pelo Gateway). Troque em qualquer uso fora de dev.
JWT_SECRET=troque-este-segredo-em-dev
JWT_EXPIRES_MINUTES=60
