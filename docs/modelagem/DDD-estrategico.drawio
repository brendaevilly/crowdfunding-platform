        <mxCell id="xpwPdsgoaNBEcTpz3pcz-20" parent="1" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=light-dark(#000000,#000000);fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;strokeWidth=5;" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(0, 0, 0)); font-size: 47px;&quot;&gt;&lt;b&gt;AWS Cloud&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="1598" width="3855" x="-1566" y="-2062" as="geometry" />
        </mxCell>
        <mxCell id="tqzlgKo0ad2dpvVb3Zk0-85" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=28;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);container=0;" value="&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Open Host Service (OHS) + Published Language&lt;/span&gt; — um contexto expõe uma interface/protocolo estável para vários consumidores (Usuário -&amp;gt; KYC | Usuário -&amp;gt; Campanha).&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Customer/Supplier&lt;/span&gt; — o contexto upstream influencia decisões do downstream, que tem algumavoz sobre o contrato (Campanha -&amp;gt; Aporte | Aporte -&amp;gt; Custódia | Custódia -&amp;gt; Participação e retornos).&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Conformist &lt;/span&gt;— o downstream aceita o modelo do upstream sem negociar (Todos -&amp;gt; Notificação).&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Anticorruption Layer (ACL)&lt;/span&gt; — o contexto cria uma camada de tradução para não deixar omodelo externo contaminar seu próprio modelo (KYC -&amp;gt; Aporte).&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="530.5" width="912" x="-236" y="-400" as="geometry" />
        </mxCell>
