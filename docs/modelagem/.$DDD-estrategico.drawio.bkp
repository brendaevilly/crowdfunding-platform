        <mxCell id="tqzlgKo0ad2dpvVb3Zk0-85" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=24;labelBackgroundColor=none;fontColor=light-dark(#000000,#000000);container=0;" value="&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Open Host Service (OHS) + Published Language&lt;/span&gt; — um contexto expõe uma interface/protocoloestável para vários consumidores.&lt;/b&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Customer/Supplier&lt;/span&gt; — o contexto upstream influencia decisões do downstream, que tem algumavoz sobre o contrato.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Conformist &lt;/span&gt;— o downstream aceita o modelo do upstream sem negociar.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;Anticorruption Layer (ACL)&lt;/span&gt; — o contexto cria uma camada de tradução para não deixar omodelo externo contaminar seu próprio modelo.&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="339" width="832" x="-929" y="31" as="geometry" />
        </mxCell>
      </root>
